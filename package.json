{
  "name": "thelastsignal-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "bun --filter '*' lint",
    "lint:web": "bun --filter @thelastsignal/web lint",
    "lint:mobile": "bun --filter @thelastsignal/mobile lint",
    "lint:data": "bun --filter @thelastsignal/data lint",
    "web": "bun --filter @thelastsignal/web dev",
    "web:build": "bun --filter @thelastsignal/web build",
    "mobile": "bun --filter @thelastsignal/mobile start",
    "mobile:android": "bun --filter @thelastsignal/mobile android",
    "mobile:ios": "bun --filter @thelastsignal/mobile ios",
    "mobile:web": "bun --filter @thelastsignal/mobile web",
    "typecheck": "cd packages/data && bun x tsc --noEmit && cd ../../apps/mobile && bun x tsc --noEmit && cd ../web && bun x tsc --noEmit",
    "check": "bun run lint && bun run typecheck"
  }
}
